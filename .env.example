# Copy this file to .env and fill in your values.
# Never commit .env to git (it's in .gitignore).

# Database - PostgreSQL connection string (used by the Nest app at runtime).
# Local: postgresql://USER:PASSWORD@localhost:5432/nest_db
# Neon (pooled, for app): postgresql://USER:PASSWORD@ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nest_db"

# Optional: for Neon only. Use the DIRECT connection (no -pooler in host) for Prisma migrations.
# Get both from Neon Console → Connect. Add ?sslmode=require to both.
# DIRECT_URL (Supabase): postgresql://postgres.[REF]:[PASS]@db.[REF].supabase.co:5432/postgres?sslmode=require&connect_timeout=30
# Query params must come after ONE "?" (e.g. ?sslmode=require&connect_timeout=30). Wrong: /postgres&connect_timeout=30
# DIRECT_URL="postgresql://..."

# Secret used to sign JWTs. Use a long random string in production.
JWT_SECRET="your-super-secret-key-change-in-production"

# Optional: port (default 3000)
# PORT=3000
